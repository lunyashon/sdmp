FROM golang:1.27.0-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download && go mod verify

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/sdmp-worker ./cmd/worker/main.go

FROM gcr.io/distroless/static-debian12

ENV TZ=Europe/Moscow

WORKDIR /app

COPY --from=builder /out/sdmp-worker /app/sdmp-worker
COPY config/.env /app/config/.env

ENTRYPOINT ["/app/sdmp-worker"]