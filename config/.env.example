READ_HEADER_TIMEOUT=5
READ_TIMEOUT=30
WRITE_TIMEOUT=120
IDLE_TIMEOUT=30

PORT=8080

LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_OUTPUT_PATH=./logs/app.log
LOG_OUTPUT_MAX_SIZE=10
LOG_OUTPUT_MAX_AGE=7
LOG_OUTPUT_MAX_BACKUPS=10

# Yandex Object Storage
YA_S3_IDENTIFIED_KEY=
YA_S3_SECRET_KEY=
YA_S3_ENDPOINT=https://storage.yandexcloud.net
YA_S3_REGION=ru-central1
YA_S3_BUCKET=

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=admin
DB_PASS=
DB_NAME=sdmp
DB_MAX_CONNS=32

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# phone.search
PHONE_SEARCH_URL=https://bfl-activity.ru/api/v1/retarget/phone.search
PHONE_SEARCH_SECRET_TOKEN=
PHONE_SEARCH_SECRE_TOKEN=

# Skorozvon
SKOROZVON_RPS=8
SKOROZVON_LOGIN=
SKOROZVON_API_KEY=
SKOROZVON_APP_ID=
SKOROZVON_APP_KEY=

# Zarya: soda.lead.search + inbound Bitrix webhook (crm.duplicate.findbycomm / crm.lead.get)
ZARYA_API_URL=
ZARYA_BITRIX_URL=
# 1 — не ходить на crm-zennit.ru, писать «Чистый». Снять, когда Beget поднимется.
ZARYA_FORCE_CLEAN=0

# CRMCalls
CRMCALLS_BASE_URL=https://cc.crmcalls.ru
CRMCALLS_API_KEY=
CRMCALLS_RPS=8
# Заголовок X-API-KEY на /rest/crmcalls/events. Пусто — постбэк не принимается.
CRMCALLS_POSTBACK_KEY=

# Bitrix24 outgoing crm.lead.add
SODATECH_BX24_URL=

# Публичная ссылка на запись (прокси СК/CRMCalls). Секрет обязателен, иначе в Б24 уходит прямой URL СК.
PUBLIC_BASE_URL=https://cdp-dmp.ru
RECORDING_LINK_SECRET=

# API
SWAGGER_VERSION=v1
SWAGGER_TOKEN=

# Единственная учётка интерфейса. Пустой AUTH_PASSWORD выключает проверку.
AUTH_LOGIN=
AUTH_PASSWORD=

# Worker
GOMAXPROCS=4

# Incoming crm.lead.add rate limit per source token. 0 disables.
CRM_LEAD_ADD_RPS=100
CRM_LEAD_ADD_BURST=32
